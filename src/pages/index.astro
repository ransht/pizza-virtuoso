---
import he from '../i18n/he.json';

// GitHub Pages cannot issue a 301, so this is an instant meta refresh, which search engines
// treat as a permanent redirect. It must stay indexable: a noindex here would tell crawlers to
// drop the URL most external links point to. Title, description and Open Graph tags are for
// link previews of the bare domain, which do not follow the refresh.
const destination = '/he/';
const origin = Astro.site || Astro.url;
const target = new URL(destination, origin);
const image = new URL('/images/og-pizza.jpg', origin);
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={target} />
    <link rel="alternate" hreflang="he-IL" href={target} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', origin)} />
    <link rel="alternate" hreflang="x-default" href={target} />
    <meta name="description" content={he.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={he.meta.title} />
    <meta property="og:description" content={he.meta.description} />
    <meta property="og:url" content={target} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={he.meta.ogAlt} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{he.meta.title}</title>
  </head>
  <body><p><a href={destination}>מעבר לאתר פיצה וירטואוז</a></p></body>
</html>
