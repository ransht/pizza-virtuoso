---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import LoveCampaign from '../../components/LoveCampaign.astro';
import { dictionaries, isLanguage, languages } from '../../lib/i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLanguage(langParam)) return Astro.redirect('/he/');
const lang = langParam;
const t = dictionaries[lang];
const campaignMeta = lang === 'he' ? {
  title: 'יום האהבה בפיצה וירטואוז | פיצות לב ומבצעים זוגיים',
  description: 'חוגגים ט״ו באב עם פיצות לב ב־MEDIUM וב־LARGE, מבצעים זוגיים והזמנה מהירה ב־WhatsApp.',
  image: '/images/og-love-campaign.jpg',
  imageAlt: 'פיצת מרגריטה בצורת לב של פיצה וירטואוז',
} : undefined;
---
<BaseLayout {lang} {t} meta={campaignMeta}>
  {lang === 'he' ? <LoveCampaign /> : <HomePage {lang} {t} />}
</BaseLayout>
