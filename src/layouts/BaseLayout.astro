---
import '../styles/global.css';
import business from '../content/business/config.json';
import menu from '../content/menu/menu.json';
import FacebookPixel from '../components/FacebookPixel.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AccessibilityTools from '../components/AccessibilityTools.astro';
import { direction, locale, type Language, type Messages } from '../lib/i18n';
import { openingHoursSchema, specialOpeningHoursSchema } from '../lib/hours';

interface Props {
  lang: Language;
  t: Messages;
  meta?: { title: string; description: string; image: string; imageAlt: string };
  canonicalPath?: string;
  facebookPixelId?: string;
  preloadImage?: string;
  noindex?: boolean;
}
const { lang, t, meta, canonicalPath, facebookPixelId, preloadImage, noindex = false } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || Astro.url.origin;
const localizedPath = canonicalPath || `/${lang}/`;
const canonical = new URL(localizedPath, origin);
const metaTitle = meta?.title || t.meta.title;
const metaDescription = meta?.description || t.meta.description;
const metaImage = meta?.image || '/images/og-pizza.jpg';
const metaImageAlt = meta?.imageAlt || t.meta.ogAlt;
const orderUrl = import.meta.env.PUBLIC_ORDER_URL || business.orderUrl;
const isHomePage = localizedPath === `/${lang}/`;
const fontSubset = lang === 'he' ? 'hebrew' : 'latin';
const inLanguage = lang === 'he' ? 'he-IL' : 'en';
const restaurantId = new URL('/#restaurant', origin).href;
const websiteId = new URL('/#website', origin).href;
const menuId = new URL(`/${lang}/#menu`, origin).href;
const hasLanguageAlternative = localizedPath.startsWith(`/${lang}/`) && (lang === 'he' || lang === 'en');
const alternatePath = (targetLang: Language) => localizedPath.replace(`/${lang}/`, `/${targetLang}/`);
const restaurant: Record<string, unknown> = {
  '@type': 'Restaurant',
  '@id': restaurantId,
  name: business.name,
  alternateName: business.alternateName,
  description: t.meta.description,
  url: new URL('/he/', origin).href,
  image: [new URL('/images/hero/hero-pizza-1672.webp', origin).href, new URL('/images/og-pizza.jpg', origin).href],
  logo: new URL('/favicon.svg', origin).href,
  servesCuisine: ['Pizza', 'Italian', 'Dairy', 'Kosher'],
  menu: menuId,
  hasMenu: { '@id': menuId },
};
if (business.telephone) restaurant.telephone = business.telephone;
if (business.address.streetAddress) restaurant.address = {
  '@type': 'PostalAddress',
  streetAddress: business.address.streetAddress,
  addressLocality: business.address.addressLocality,
  addressCountry: business.address.addressCountry,
};
if (business.geo.latitude && business.geo.longitude) restaurant.geo = { '@type': 'GeoCoordinates', ...business.geo };
if (business.openingHoursVerified && business.openingHours.length) restaurant.openingHoursSpecification = openingHoursSchema();
if (business.openingHoursVerified && business.specialOpeningHours.length) restaurant.specialOpeningHoursSpecification = specialOpeningHoursSchema();
if (business.priceRange) restaurant.priceRange = business.priceRange;
if (business.city) restaurant.areaServed = { '@type': 'City', name: business.city };
const sameAs = [business.googleBusinessUrl, business.instagramUrl, business.tiktokUrl, business.facebookUrl].filter(Boolean);
if (sameAs.length) restaurant.sameAs = sameAs;
if (business.googleBusinessUrl || business.googleMapsUrl) restaurant.hasMap = business.googleBusinessUrl || business.googleMapsUrl;
if (orderUrl) restaurant.potentialAction = { '@type': 'OrderAction', target: orderUrl };
const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: new URL('/', origin).href,
  name: business.name,
  alternateName: business.alternateName,
  inLanguage: ['he-IL', 'en'],
  publisher: { '@id': restaurantId },
};
const webPage = {
  '@type': 'WebPage',
  '@id': new URL(`${localizedPath}#webpage`, origin).href,
  url: canonical.href,
  name: metaTitle,
  description: metaDescription,
  inLanguage,
  isPartOf: { '@id': websiteId },
  about: { '@id': restaurantId },
  primaryImageOfPage: new URL(metaImage, origin).href,
};
// Mirrors the visible #menu section: same items, names and prices, from the same data files.
const menuItemNames = t.menu.items as Record<string, { name: string; description: string }>;
const menuPriceLabels = t.menu.priceLabels as Record<string, string>;
const menuCategoryNames = t.menu.categories as Record<string, string>;
const menuSchema = {
  '@type': 'Menu',
  '@id': menuId,
  name: `${t.hero.brand} – ${t.nav.menu}`,
  url: menuId,
  inLanguage,
  hasMenuSection: menu.categories.map((category) => ({
    '@type': 'MenuSection',
    name: menuCategoryNames[category.id],
    hasMenuItem: category.items.filter((item) => item.prices.length > 0).map((item) => ({
      '@type': 'MenuItem',
      name: menuItemNames[item.id].name,
      ...(menuItemNames[item.id].description ? { description: menuItemNames[item.id].description } : {}),
      offers: item.prices.map((price) => ({
        '@type': 'Offer',
        ...(price.label === 'unit' ? {} : { name: menuPriceLabels[price.label] }),
        price: price.price,
        priceCurrency: menu.currency,
      })),
    })),
  })),
};
const faqPage = {
  '@type': 'FAQPage',
  '@id': new URL(`${localizedPath}#faq`, origin).href,
  inLanguage,
  mainEntity: t.faq.items.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
};
const jsonLd = { '@context': 'https://schema.org', '@graph': isHomePage ? [restaurant, website, webPage, menuSchema, faqPage] : [website] };
---
<!doctype html>
<html lang={lang} dir={direction(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9f261c" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {hasLanguageAlternative && <link rel="alternate" hreflang="he-IL" href={new URL(alternatePath('he'), origin)} />}
    {hasLanguageAlternative && <link rel="alternate" hreflang="en" href={new URL(alternatePath('en'), origin)} />}
    {hasLanguageAlternative && <link rel="alternate" hreflang="x-default" href={new URL(alternatePath('he'), origin)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {isHomePage && <link rel="preload" as="image" href="/images/hero/hero-pizza-mobile.webp" media="(max-width: 720px)" fetchpriority="high" />}
    {isHomePage && <link rel="preload" as="image" imagesrcset="/images/hero/hero-pizza-1100.webp 1100w, /images/hero/hero-pizza-1672.webp 1672w" imagesizes="100vw" media="(min-width: 721px)" fetchpriority="high" />}
    <link rel="preload" href={`/fonts/assistant-${fontSubset}.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/noto-serif-${fontSubset}.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(metaImage, origin)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaImageAlt} />
    <meta property="og:locale" content={locale(lang)} />
    <meta property="og:locale:alternate" content={locale(lang === 'he' ? 'en' : 'he')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(metaImage, origin)} />
    <title>{metaTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <AccessibilityTools {lang} />
    <GoogleAnalytics t={t.analytics} />
    {facebookPixelId && <FacebookPixel pixelId={facebookPixelId} />}
  </body>
</html>
