---
import business from '../content/business/config.json';
import menu from '../content/menu/menu.json';
import dealsData from '../content/deals/deals.json';
import galleryData from '../content/gallery/photos.json';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Coupon from './Coupon.astro';
import WazeIcon from './WazeIcon.astro';
import GoogleMapsIcon from './GoogleMapsIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import TikTokIcon from './TikTokIcon.astro';
import FacebookIcon from './FacebookIcon.astro';
import { hoursRows, openStatusData, specialHoursRows } from '../lib/hours';
import { orderHref } from '../lib/order';
import type { Language, Messages } from '../lib/i18n';
interface Props { lang: Language; t: Messages; }
const { lang, t } = Astro.props;

type Localized = Record<Language, string>;
// Deals and gallery photos are owner-provided content. Each section renders only when its file has entries.
interface Deal { id: string; name: Localized; includes: Localized; price: number; regularPrice?: number; orderPath?: string }
interface Photo { src: string; width: number; height: number; alt: Localized }
const deals = dealsData.deals as Deal[];
const photos = galleryData.photos as Photo[];

const shareUrl = new URL(`https://wa.me/?text=${encodeURIComponent(`${t.shareText} ${new URL(`/${lang}/`, Astro.site || Astro.url).href}`)}`);
const whatsappUrl = business.whatsapp ? `https://wa.me/${business.whatsapp.replace('+', '')}?text=${encodeURIComponent(t.contact.whatsappMessage)}` : '';
const mapsUrl = business.googleBusinessUrl || business.googleMapsUrl;
const menuItems = t.menu.items as Record<string, { name: string; description: string; imageAlt?: string }>;
const priceLabels = t.menu.priceLabels as Record<string, string>;
// Variants come from scripts/generate-menu-images.mjs; cards are full width up to 720px and at most 220px above it.
const menuImage = (image: string) => {
  const base = image.replace('/images/', '/images/menu/').replace('-menu.webp', '');
  return {
    src: `${base}-800.webp`,
    srcset: [480, 800, 1122].map((width) => `${base}-${width}.webp ${width}w`).join(', '),
    sizes: '(max-width: 720px) calc(100vw - 32px), 220px',
    width: 1122,
    height: 842,
  };
};
const rating = business.googleRating;
const ratingChecked = rating.checkedOn.slice(5, 7) + '/' + rating.checkedOn.slice(0, 4);
const weekHours = hoursRows(lang);
const specialHours = specialHoursRows(lang);
const external = { target: '_blank', rel: 'noopener noreferrer' };
---
<Header {lang} {t} hasDeals={deals.length > 0} />
<main id="main">
  <Hero {t} />

  <section class="why section" id="why" aria-labelledby="why-title">
    <div class="page-shell">
      <header class="why-heading">
        <h2 id="why-title">{t.why.title}</h2>
        <img src="/images/gad-logo-264.webp" width="264" height="219" loading="lazy" decoding="async" alt={t.why.supplierAlt} />
      </header>
      <ul class="why-list">
        {t.why.items.map((item, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.title}</strong>
            {item.note && <small>{item.note}</small>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {deals.length > 0 && (
    <section class="deals section" id="deals" aria-labelledby="deals-title">
      <div class="page-shell">
        <header class="deals-heading"><p class="section-kicker">{t.deals.kicker}</p><h2 id="deals-title">{t.deals.title}</h2></header>
        <div class="deal-list">
          {deals.map((deal) => (
            <article class="deal">
              <h3>{deal.name[lang]}</h3>
              <p class="deal-includes"><span class="sr-only">{t.deals.includes}: </span>{deal.includes[lang]}</p>
              <p class="deal-price"><strong><bdi>{deal.price}</bdi> {t.menu.currency}</strong>{deal.regularPrice && deal.regularPrice > deal.price && <span>{t.deals.save} <bdi>{deal.regularPrice - deal.price}</bdi> {t.menu.currency}</span>}</p>
              <a class="button button-primary" href={orderHref(deal.orderPath)} data-order-link data-track="deal_click" data-track-location="deals" data-track-id={deal.id}>{t.deals.order}</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="menu-section section" id="menu" aria-labelledby="menu-title">
    <div class="page-shell">
      <header class="menu-heading">
        <div><p class="section-kicker">{t.menu.kicker}</p><h2 id="menu-title">{t.menu.title}</h2></div>
        <p>{t.menu.intro}</p>
      </header>
      <nav class="category-nav" aria-label={t.menu.kicker}>
        {menu.categories.map((category, index) => <a class={index === 0 ? 'active' : ''} aria-current={index === 0 ? 'true' : undefined} href={`#category-${category.id}`}>{t.menu.categories[category.id as keyof typeof t.menu.categories]}</a>)}
      </nav>
      <div class="menu-catalog">
        {menu.categories.map((category, categoryIndex) => (
          <section class="menu-category" id={`category-${category.id}`} aria-labelledby={`category-title-${category.id}`}>
            <header class="menu-category-heading">
              <div><span>0{categoryIndex + 1}</span><h3 id={`category-title-${category.id}`}>{t.menu.categories[category.id as keyof typeof t.menu.categories]}</h3></div>
              <p>{t.menu.categoryNotes[category.id as keyof typeof t.menu.categoryNotes]}</p>
            </header>
            <div class={`menu-items menu-items-${category.id}`}>
              {category.items.map((item) => (
                <article class:list={['menu-item', `menu-item-${item.kind}`, 'image' in item && item.image && 'menu-item-has-image']}>
                  {'image' in item && item.image && <div class="menu-item-media"><img {...menuImage(item.image)} loading="lazy" decoding="async" alt={menuItems[item.id].imageAlt || menuItems[item.id].name} /></div>}
                  <div class="menu-item-copy">
                    <h4>{menuItems[item.id].name}</h4>
                    {menuItems[item.id].description && <p>{menuItems[item.id].description}</p>}
                    {item.kind === 'included' && <span class="included-label">{t.menu.included}</span>}
                  </div>
                  {item.prices.length > 0 && (
                    <dl class="price-list">
                      {item.prices.map((price) => <div><dt>{priceLabels[price.label]}</dt><dd><bdi>{price.price}</bdi> {t.menu.currency}</dd></div>)}
                    </dl>
                  )}
                </article>
              ))}
            </div>
            {categoryIndex === 0 && <p class="menu-note">{t.menu.sauceNote}</p>}
          </section>
        ))}
      </div>
      <div class="menu-order-bar">
        <Coupon {t} location="menu" />
        <a class="button button-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="menu">{t.hero.order}</a>
      </div>
      <a class="share-link" href={shareUrl} {...external}><span aria-hidden="true">↗</span>{t.menu.share}</a>
    </div>
  </section>

  {/* The calculator is Hebrew-only, so it is offered on the Hebrew page alone. */}
  {lang === 'he' && (
    <aside class="party" aria-labelledby="party-title">
      <div class="page-shell party-inner">
        <div>
          <p class="section-kicker">{t.party.kicker}</p>
          <h2 id="party-title">{t.party.title}</h2>
          <p>{t.party.body}</p>
        </div>
        <a class="button button-primary" href={business.calcUrl} data-track="calculator_click" data-track-location="party">{t.party.action}</a>
      </div>
    </aside>
  )}

  <section class="story section" id="story" aria-labelledby="story-title">
    <div class="page-shell story-grid">
      <div class="story-copy">
        <p class="section-kicker">{t.story.kicker}</p>
        <h2 id="story-title">{t.story.title}</h2>
        <p class="story-lead">{t.story.lead}</p>
        {t.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <figure class="story-figure">
        <img src="/images/dough-story.webp" width="820" height="1025" loading="lazy" decoding="async" alt={t.story.imageAlt} />
        <figcaption><strong>24</strong><span>hours<br />of patience</span></figcaption>
      </figure>
    </div>
    <div class="page-shell">
      <aside class="mozzarella-story" aria-labelledby="mozzarella-title">
        <div class="mozzarella-explainer">
          <p class="section-kicker">{t.mozzarella.kicker}</p>
          <h3 id="mozzarella-title">{t.mozzarella.title}</h3>
          {t.mozzarella.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mozzarella-origin">
          <span aria-hidden="true">M</span>
          <p class="section-kicker">{t.mozzarella.storyKicker}</p>
          <h3>{t.mozzarella.storyTitle}</h3>
          <p>{t.mozzarella.story}</p>
          <a href={t.mozzarella.sourceUrl} {...external}>{t.mozzarella.sourceLabel}<span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="gallery section" aria-labelledby="gallery-title">
      <div class="page-shell">
        <header><p class="section-kicker">{t.gallery.kicker}</p><h2 id="gallery-title">{t.gallery.title}</h2></header>
        <ul class="gallery-grid">
          {photos.map((photo) => <li><img src={photo.src} width={photo.width} height={photo.height} loading="lazy" decoding="async" alt={photo.alt[lang]} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="reviews section" id="reviews" aria-labelledby="reviews-title">
    <div class="page-shell reviews-grid">
      <div class="reviews-score">
        <p class="section-kicker">{t.reviews.kicker}</p>
        <h2 id="reviews-title">{t.reviews.title}</h2>
        <a class="rating" href={mapsUrl} {...external} aria-label={t.reviews.ratingLabel.replace('{value}', String(rating.value))} data-track="reviews_click" data-track-location="reviews">
          <strong>{rating.value}</strong>
          <span>
            <span class="stars" style={`--fill: ${rating.value * 20}%`} aria-hidden="true">★★★★★</span>
            <span class="rating-count">{t.reviews.count.replace('{count}', String(rating.count))}</span>
          </span>
        </a>
        <p class="rating-meta">{t.reviews.checked.replace('{date}', ratingChecked)} · <a href={mapsUrl} {...external}>{t.reviews.readAll}</a></p>
      </div>
      <div class="review-ask">
        <h3>{t.reviews.askTitle}</h3>
        <a class="button button-primary" href={business.googleReviewUrl} {...external} data-track="review_request_click" data-track-location="reviews">{t.reviews.askAction}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <aside class="venue" aria-labelledby="venue-title">
    <div class="page-shell venue-inner">
      <div>
        <p class="section-kicker">{t.venue.kicker}</p>
        <h2 id="venue-title">{t.venue.title}</h2>
        <p>{t.venue.body}</p>
      </div>
      <div class="venue-actions">
        <a class="button button-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="venue">{t.venue.order}</a>
        <a class="button button-ghost" href={mapsUrl} {...external}>{t.venue.navigate}</a>
      </div>
    </div>
  </aside>

  <section class="faq section" id="faq" aria-labelledby="faq-title">
    <div class="page-shell faq-inner">
      <header class="faq-heading"><p class="section-kicker">{t.faq.kicker}</p><h2 id="faq-title">{t.faq.title}</h2></header>
      <div class="faq-list">
        {t.faq.items.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="contact section" id="contact" aria-labelledby="contact-title">
    <div class="page-shell">
      <header class="contact-heading"><p class="section-kicker">{t.contact.kicker}</p><h2 id="contact-title">{t.contact.title}</h2></header>
      <div class="info-grid">
        <div class="info-card">
          <h3>{t.hero.brand} <span>· {t.hero.brandLatin}</span></h3>
          <p class="info-intro">{t.contact.intro}</p>
          <dl class="info-list">
            <div><dt>{t.contact.labels.address}</dt><dd><address><a href={mapsUrl} {...external}>{t.contact.addressValue}</a></address></dd></div>
            <div><dt>{t.contact.labels.phone}</dt><dd><a href={`tel:${business.telephone}`} data-track="phone_click" data-track-location="contact"><bdi>{business.telephoneDisplay}</bdi></a></dd></div>
            <div>
              <dt>{t.contact.labels.hours}</dt>
              <dd>
                <ul class="hours-list">
                  {weekHours.map((row) => <li class:list={{ 'is-closed': row.closed }}><span>{row.days}{row.note && ` (${row.note})`}</span><bdi>{row.hours}</bdi></li>)}
                </ul>
                <p class="open-status" data-open-status={JSON.stringify(openStatusData())} data-open={t.contact.openNow} data-closed={t.contact.closedNow} data-opens={t.contact.opensAt} hidden></p>
              </dd>
            </div>
            {specialHours.length > 0 && (
              <div>
                <dt>{t.contact.labels.specialHours}</dt>
                <dd><ul class="hours-list">{specialHours.map((row) => <li class:list={{ 'is-closed': row.closed }}><span><bdi>{row.days}</bdi>{row.note && ` · ${row.note}`}</span><bdi>{row.hours}</bdi></li>)}</ul></dd>
              </div>
            )}
          </dl>
          <div class="info-actions">
            <a class="button button-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="contact">{t.contact.order}</a>
            <a class="button button-outline" href={`tel:${business.telephone}`} data-track="phone_click" data-track-location="contact-button">{t.contact.call}</a>
            {whatsappUrl && <a class="button button-outline" href={whatsappUrl} {...external} data-track="whatsapp_click" data-track-location="contact"><WhatsAppIcon />{t.contact.whatsappAction}</a>}
          </div>
          <div class="info-navigation">
            <a class="navigation-button" href={business.wazeUrl} {...external} aria-label={t.contact.wazeAction} title={t.contact.wazeAction} data-track="navigate_click" data-track-location="waze"><WazeIcon /></a>
            <a class="navigation-button" href={mapsUrl} {...external} aria-label={t.contact.mapsAction} title={t.contact.mapsAction} data-track="navigate_click" data-track-location="google-maps"><GoogleMapsIcon /></a>
          </div>
        </div>
        <div class="kosher-panel">
          <h3>{t.kosher.title}</h3>
          {business.kosherSupervision && <p>{t.kosher.supervision}</p>}
        </div>
      </div>
      <div class="social-cards">
        {business.tiktokUrl && (
          <a class="social-card social-card-tiktok" href={business.tiktokUrl} {...external} aria-label={`${t.contact.tiktokAction} — TikTok`}>
            <span class="social-card-icon"><TikTokIcon /></span>
            <span class="social-card-copy"><small>{t.contact.tiktokKicker}</small><strong>{t.contact.tiktokTitle}</strong><span>{t.contact.tiktokBody}</span></span>
            <span class="social-card-action">{t.contact.tiktokAction}<span aria-hidden="true">↗</span></span>
          </a>
        )}
        {business.facebookUrl && (
          <a class="social-card social-card-facebook" href={business.facebookUrl} {...external} aria-label={`${t.contact.facebookAction} — Facebook`}>
            <span class="social-card-icon"><FacebookIcon /></span>
            <span class="social-card-copy"><small>{t.contact.facebookKicker}</small><strong>{t.contact.facebookTitle}</strong><span>{t.contact.facebookBody}</span></span>
            <span class="social-card-action">{t.contact.facebookAction}<span aria-hidden="true">↗</span></span>
          </a>
        )}
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div><p class="footer-brand">{t.hero.brand}</p><address><a href={mapsUrl} {...external}>{t.contact.addressValue}</a><br /><a href={`tel:${business.telephone}`} data-track="phone_click" data-track-location="footer"><bdi>{business.telephoneDisplay}</bdi></a></address><p>{t.footer.tagline}</p></div>
    <p><a class="footer-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="footer">{t.nav.order}</a>{lang === 'he' && <><br /><a class="footer-accessibility" href={business.calcUrl} data-track="calculator_click" data-track-location="footer">{t.party.footer}</a></>}</p>
    <p>© {new Date().getFullYear()} {t.hero.brand}. {t.footer.rights}<br /><a class="footer-accessibility" href={`/${lang}/accessibility/`}>{lang === 'he' ? 'הצהרת נגישות' : 'Accessibility statement'}</a></p>
  </div>
</footer>

<nav class="mobile-action-bar" aria-label={t.a11y.quickActions}>
  <a class="mobile-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="sticky-bar">{t.mobile.order}</a>
  <a class="mobile-call" href={`tel:${business.telephone}`} data-track="phone_click" data-track-location="sticky-bar">{t.mobile.call}</a>
</nav>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const toggleHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  toggleHeader();
  addEventListener('scroll', toggleHeader, { passive: true });

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
      menu.hidden = !open;
      document.body.classList.toggle('nav-open', open);
    };
    const closeMenu = () => { setOpen(false); toggle.focus(); };
    toggle.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(opening);
      if (opening) menu.querySelector<HTMLElement>('a')?.focus();
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) closeMenu();
      if (event.key === 'Tab' && !menu.hidden) {
        const focusable = [toggle, ...menu.querySelectorAll<HTMLElement>('a, button')];
        const first = focusable[0]; const last = focusable.at(-1);
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
  }

  const categoryLinks = document.querySelectorAll<HTMLAnchorElement>('.category-nav a');
  categoryLinks.forEach((link) => link.addEventListener('click', () => {
    categoryLinks.forEach((item) => { item.classList.remove('active'); item.removeAttribute('aria-current'); });
    link.classList.add('active'); link.setAttribute('aria-current', 'true');
  }));

  // --- Campaign attribution -------------------------------------------------------------
  // Campaign parameters from the landing URL (Facebook, WhatsApp, Google…) are remembered for
  // the visit and forwarded to the ordering system, which stores them with the order.
  // Only this fixed list is forwarded; nothing personal is read or sent.
  const campaignKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid'];
  const campaignStore = 'pizza-virtuoso-campaign';
  const campaign: Record<string, string> = {};
  const landing = new URLSearchParams(location.search);
  campaignKeys.forEach((key) => { const value = landing.get(key)?.trim().slice(0, 100); if (value) campaign[key] = value; });
  try {
    if (Object.keys(campaign).length) sessionStorage.setItem(campaignStore, JSON.stringify(campaign));
    else Object.assign(campaign, JSON.parse(sessionStorage.getItem(campaignStore) || '{}'));
  } catch { /* storage unavailable: the parameters of this page view are still forwarded */ }
  if (!Object.keys(campaign).length && document.referrer) {
    // No campaign tag: keep the real origin instead of letting every order look like a referral from this site.
    const host = new URL(document.referrer).hostname;
    if (/(^|\.)google\./.test(host)) Object.assign(campaign, { utm_source: 'google', utm_medium: 'organic' });
    else if (/(^|\.)(facebook|fb|instagram)\.com$/.test(host)) Object.assign(campaign, { utm_source: 'facebook', utm_medium: 'social' });
  }
  document.querySelectorAll<HTMLAnchorElement>('a[data-order-link]').forEach((link) => {
    const url = new URL(link.href);
    Object.entries(campaign).forEach(([key, value]) => url.searchParams.set(key, value));
    link.href = url.href;
  });

  // --- Analytics events -----------------------------------------------------------------
  // gtag exists only after the visitor accepted analytics (see GoogleAnalytics.astro).
  const track = (event: string, parameters: Record<string, string | undefined> = {}) => {
    (window as Window & { gtag?: (...args: unknown[]) => void }).gtag?.('event', event, parameters);
  };
  document.addEventListener('click', (event) => {
    const element = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
    if (element) track(element.dataset.track!, { link_location: element.dataset.trackLocation, item_id: element.dataset.trackId });
  });

  // --- Coupon ---------------------------------------------------------------------------
  const copyText = async (text: string) => {
    try { await navigator.clipboard.writeText(text); return true; } catch { /* older or in-app browsers */ }
    const field = document.createElement('textarea');
    field.value = text; field.setAttribute('readonly', ''); field.style.cssText = 'position:fixed;opacity:0';
    document.body.append(field); field.select();
    const copied = document.execCommand('copy');
    field.remove();
    return copied;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
    const label = button.textContent;
    const coupon = button.closest<HTMLElement>('[data-coupon]');
    button.addEventListener('click', async () => {
      if (!(await copyText(button.dataset.copyCode!))) {
        // Copying is blocked (some in-app browsers): select the code so a long press can copy it.
        const code = coupon?.querySelector('.coupon-code bdi');
        if (code) getSelection()?.selectAllChildren(code);
        return;
      }
      button.textContent = button.dataset.copiedLabel!;
      button.classList.add('is-copied');
      const status = coupon?.querySelector('[data-copy-status]');
      if (status) status.textContent = button.dataset.copiedLabel!;
      track('coupon_copy', { link_location: coupon?.dataset.trackLocation });
      setTimeout(() => { button.textContent = label; button.classList.remove('is-copied'); if (status) status.textContent = ''; }, 2500);
    });
  });
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      seen.unobserve(entry.target);
      track('coupon_view', { link_location: (entry.target as HTMLElement).dataset.trackLocation });
    }), { threshold: 0.6 });
    document.querySelectorAll('[data-coupon]').forEach((element) => seen.observe(element));
  }

  // --- Open now -------------------------------------------------------------------------
  // Computed in the restaurant's time zone from the same data as the hours table.
  const status = document.querySelector<HTMLElement>('[data-open-status]');
  if (status) {
    type Slot = [string, string];
    const data = JSON.parse(status.dataset.openStatus!) as { week: Slot[][]; special: { from: string; through: string; slot: Slot | null }[] };
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Jerusalem', weekday: 'short', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).map((part) => [part.type, part.value]));
    const today = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(parts.weekday);
    const date = `${parts.year}-${parts.month}-${parts.day}`;
    const now = `${parts.hour}:${parts.minute}`;
    const special = data.special.find((entry) => entry.from <= date && date <= entry.through);
    const slots = special ? (special.slot ? [special.slot] : []) : data.week[today];
    const overnight = (data.week[(today + 6) % 7] || []).find(([opens, closes]) => closes < opens && now < closes);
    const current = overnight || slots.find(([opens, closes]) => now >= opens && (closes < opens || now < closes));
    const next = slots.find(([opens]) => now < opens);
    status.textContent = current
      ? status.dataset.open!.replace('{time}', current[1])
      : next ? `${status.dataset.closed} · ${status.dataset.opens!.replace('{time}', next[0])}` : status.dataset.closed!;
    status.classList.toggle('is-open', Boolean(current));
    status.hidden = false;
  }
</script>
