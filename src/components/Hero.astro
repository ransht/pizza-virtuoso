---
import business from '../content/business/config.json';
import Coupon from './Coupon.astro';
import { orderHref } from '../lib/order';
import type { Messages } from '../lib/i18n';
interface Props { t: Messages; }
const { t } = Astro.props;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <picture class="hero-media">
    <source media="(max-width: 720px)" srcset="/images/hero/hero-pizza-mobile.webp" width="706" height="941" />
    <img src="/images/hero/hero-pizza-1672.webp" srcset="/images/hero/hero-pizza-1100.webp 1100w, /images/hero/hero-pizza-1672.webp 1672w" sizes="100vw" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" alt={t.meta.ogAlt} />
  </picture>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-content page-shell">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <p class="hero-brand">{t.hero.brand} <span>· {t.hero.brandLatin}</span></p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <ul class="hero-points" aria-label={t.hero.pointsLabel}>
      {t.hero.points.map((point) => <li>{point}</li>)}
    </ul>
    <Coupon {t} location="hero" />
    <div class="hero-buttons">
      <a class="button button-order hero-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="hero">{t.hero.order}</a>
      <a class="button button-ghost" href={`tel:${business.telephone}`} data-track="phone_click" data-track-location="hero">{t.hero.call}<bdi>{business.telephoneDisplay}</bdi></a>
    </div>
  </div>
</section>
