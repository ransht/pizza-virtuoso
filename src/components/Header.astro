---
import { orderHref } from '../lib/order';
import type { Language, Messages } from '../lib/i18n';
interface Props { lang: Language; t: Messages; hasDeals: boolean; }
const { lang, t, hasDeals } = Astro.props;
const otherLang = lang === 'he' ? 'en' : 'he';
const links = ([
  ['menu', '#menu'], ['deals', '#deals'], ['why', '#why'], ['reviews', '#reviews'], ['contact', '#contact'],
] as const).filter(([key]) => key !== 'deals' || hasDeals);
---
<a class="skip-link" href="#main">{t.a11y.skip}</a>
<header class="site-header" data-header>
  <a class="brand" href={`/${lang}/`}>
    <span class="brand-mark" aria-hidden="true">V</span>
    <span class="brand-name"><strong>{t.hero.brand}</strong><small>Pizza · Pizzeria</small></span>
  </a>
  <nav class="desktop-nav" aria-label={t.a11y.mainNav}>
    {links.map(([key, href]) => <a href={href} data-track={key === 'menu' ? 'menu_click' : undefined} data-track-location="header">{t.nav[key]}</a>)}
  </nav>
  <div class="header-actions">
    <a class="language-link" href={`/${otherLang}/`} lang={otherLang} hreflang={otherLang} aria-label={`${t.a11y.language}: ${t.nav.langLabel}`}>{t.nav.langCode}</a>
    <a class="button button-small button-order" href={orderHref()} data-order-link data-track="order_now_click" data-track-location="header">{t.nav.order}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.a11y.openMenu} data-label-open={t.a11y.openMenu} data-label-close={t.a11y.closeMenu} data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav aria-label={t.a11y.mainNav}>
      {links.map(([key, href]) => <a href={href} data-track={key === 'menu' ? 'menu_click' : undefined} data-track-location="mobile-menu">{t.nav[key]}</a>)}
    </nav>
    <a class="mobile-language" href={`/${otherLang}/`} lang={otherLang}>{t.nav.langLabel}</a>
  </div>
</header>
